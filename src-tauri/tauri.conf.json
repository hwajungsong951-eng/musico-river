{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "River",
  "version": "0.1.0",
  "identifier": "com.musico.river",
  "build": {
    "frontendDist": "../frontend"
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/icon.ico"
    ]
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "River",
        "width": 240,
        "height": 200,
        "resizable": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  }
}
